          "name": "terraform-plan-or-apply",
          "phase": "main",
          "run": "cloudflare_account_id=\"${CLOUDFLARE_ACCOUNT_ID:-00000000000000000000000000000000}\"\n\nterraform_args=(\n  \"-input=false\"\n  \"-var=account_id=${cloudflare_account_id}\"\n  \"-var=project_name=example-platform-admin-console\"\n  \"-var=production_branch=main\"\n  \"-var=repo_owner=sourceplane\"\n  \"-var=repo_name=example-platform-repo\"\n  \"-var=build_command=corepack enable \u0026\u0026 pnpm turbo run build --filter=@example/admin-console\"\n  \"-var=destination_dir=dist\"\n  \"-var=root_dir=.\"\n)\n\nif [ \"staging\" = \"production\" ] \u0026\u0026 [ \"${GITHUB_REF:-}\" = \"refs/heads/main\" ]; then\n  : \"${CLOUDFLARE_ACCOUNT_ID:?CLOUDFLARE_ACCOUNT_ID is required for apply}\"\n  : \"${CLOUDFLARE_API_TOKEN:?CLOUDFLARE_API_TOKEN is required for apply}\"\n  terraform -chdir=../../infra/cloudflare-pages-admin-console apply -auto-approve \"${terraform_args[@]}\"\n  exit 0\nfi\n\nif [ -z \"${CLOUDFLARE_API_TOKEN:-}\" ] || [ -z \"${CLOUDFLARE_ACCOUNT_ID:-}\" ]; then\n  echo \"Skipping terraform plan because Cloudflare credentials are not available outside deployment contexts.\"\n  exit 0\nfi\n\nterraform -chdir=../../infra/cloudflare-pages-admin-console plan -lock=false -no-color \"${terraform_args[@]}\"\n",
          "shell": "bash",
          "onFailure": "stop"
        }
